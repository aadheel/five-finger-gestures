#!/usr/bin/env python3
"""Press a key combo once, e.g.  gesture-key super+a

Same as `five-finger-gestures --key super+a`. Kept for older configs and for
use in your own scripts. In the config, use the built-in `key super+a` action
instead. Key names: five-finger-gestures --list-keys
"""
import os, sys

if len(sys.argv) != 2:
    sys.exit(__doc__.strip())
main = os.path.join(os.path.dirname(os.path.realpath(__file__)), "five-finger-gestures")
os.execv(sys.executable, [sys.executable, main, "--key", sys.argv[1]])
